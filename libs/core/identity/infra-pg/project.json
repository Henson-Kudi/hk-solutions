{
  "name": "core-identity-infra-pg",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/identity/infra-pg/src",
  "projectType": "library",
  "tags": ["scope:core", "layer:infra-pg"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/core/identity/infra-pg",
        "main": "libs/core/identity/infra-pg/src/index.ts",
        "tsConfig": "libs/core/identity/infra-pg/tsconfig.lib.json",
        "assets": ["libs/core/identity/infra-pg/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        {
          "env": "HK_TEST_DATABASE_URL"
        },
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest"]
        }
      ]
    }
  }
}
