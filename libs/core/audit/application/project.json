{
  "name": "core-audit-application",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/audit/application/src",
  "projectType": "library",
  "tags": ["scope:core", "layer:application"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/core/audit/application",
        "main": "libs/core/audit/application/src/index.ts",
        "tsConfig": "libs/core/audit/application/tsconfig.lib.json",
        "assets": ["libs/core/audit/application/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tools/jest/**/*",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest"]
        }
      ],
      "configurations": {
        "hermes": {
          "args": ["--config=jest.hermes.config.cts"]
        }
      }
    }
  }
}
