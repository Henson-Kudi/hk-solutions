{
  "name": "platform-redis",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/platform/redis/src",
  "projectType": "library",
  "tags": ["scope:platform"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/platform/redis",
        "main": "libs/platform/redis/src/index.ts",
        "tsConfig": "libs/platform/redis/tsconfig.lib.json",
        "assets": ["libs/platform/redis/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        {
          "env": "HK_TEST_REDIS_URL"
        },
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest"]
        }
      ]
    }
  }
}
