{
  "name": "@hk/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps libs --config .dependency-cruiser.cjs",
    "verify:boundaries": "node tools/scripts/verify-boundaries.mjs",
    "lint:root": "eslint tools \"*.{mjs,cjs,js,ts}\"",
    "infra:up": "docker compose -f deploy/compose/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f deploy/compose/docker-compose.yml down"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "next": "~16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@expo/cli": "~56.1.14",
    "@nestjs/schematics": "^12.0.0",
    "@nx/eslint": "24.1.0",
    "@nx/eslint-plugin": "24.1.0",
    "@nx/expo": "24.1.0",
    "@nx/jest": "24.1.0",
    "@nx/js": "24.1.0",
    "@nx/nest": "24.1.0",
    "@nx/next": "24.1.0",
    "@nx/vite": "24.1.0",
    "@nx/vitest": "24.1.0",
    "@nx/web": "24.1.0",
    "@nx/workspace": "24.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-node": "^30.5.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.2",
    "nx": "24.1.0",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "packageManager": "pnpm@12.10.1",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  }
}
