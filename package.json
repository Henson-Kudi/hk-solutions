{
  "name": "@hk/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps libs --config .dependency-cruiser.cjs",
    "verify:boundaries": "node tools/scripts/verify-boundaries.mjs",
    "test:hermes": "nx run-many -t test --projects=tag:runtime:universal,tag:scope:contracts,tag:scope:country-pack --configuration=hermes && node tools/scripts/hermes-compile.mjs",
    "lint:root": "eslint tools \"*.{mjs,cjs,js,ts}\"",
    "infra:up": "docker compose -f deploy/compose/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f deploy/compose/docker-compose.yml down"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bullmq": "^6.7.10",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~56.0.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "next": "~16.4.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.85.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@expo/cli": "~56.1.14",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.3",
    "@nx/eslint": "24.1.0",
    "@nx/eslint-plugin": "24.1.0",
    "@nx/expo": "24.1.0",
    "@nx/jest": "24.1.0",
    "@nx/js": "24.1.0",
    "@nx/nest": "24.1.0",
    "@nx/next": "24.1.0",
    "@nx/vite": "24.1.0",
    "@nx/vitest": "24.1.0",
    "@nx/web": "24.1.0",
    "@nx/workspace": "24.1.0",
    "@swc/helpers": "~0.5.18",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-node": "^30.5.0",
    "jest-runtime": "^30.5.2",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.2",
    "nx": "24.1.0",
    "prettier": "~3.6.2",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "packageManager": "pnpm@12.10.1",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  }
}
