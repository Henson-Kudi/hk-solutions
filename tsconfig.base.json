{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "paths": {
      "@hk/platform/universal": ["./libs/platform/universal/src/index.ts"],
      "@hk/platform/config": ["./libs/platform/config/src/index.ts"],
      "@hk/platform/logger": ["./libs/platform/logger/src/index.ts"],
      "@hk/platform/errors": ["./libs/platform/errors/src/index.ts"],
      "@hk/platform/observability": [
        "./libs/platform/observability/src/index.ts"
      ],
      "@hk/platform/redis": ["./libs/platform/redis/src/index.ts"],
      "@hk/platform/queue": ["./libs/platform/queue/src/index.ts"],
      "@hk/platform/http": ["./libs/platform/http/src/index.ts"],
      "@hk/platform/nest": ["./libs/platform/nest/src/index.ts"],
      "@hk/platform/db": ["./libs/platform/db/src/index.ts"],
      "@hk/platform/testing": ["./libs/platform/testing/src/index.ts"],
      "@hk/platform/idempotency": ["./libs/platform/idempotency/src/index.ts"],
      "@hk/platform/outbox": ["./libs/platform/outbox/src/index.ts"],
      "@hk/platform/inbox": ["./libs/platform/inbox/src/index.ts"],
      "@hk/platform/internal-auth": [
        "./libs/platform/internal-auth/src/index.ts"
      ],
      "@hk/platform/redaction": ["./libs/platform/redaction/src/index.ts"],
      "@hk/platform/test-kit": ["./libs/platform/test-kit/src/index.ts"],
      "@hk/contracts/product-manifest": [
        "./libs/contracts/product-manifest/src/index.ts"
      ],
      "@hk/contracts/permissions": [
        "./libs/contracts/permissions/src/index.ts"
      ],
      "@hk/contracts/events": ["./libs/contracts/events/src/index.ts"],
      "@hk/contracts/sync": ["./libs/contracts/sync/src/index.ts"],
      "@hk/country-packs/kernel": ["./libs/country-packs/kernel/src/index.ts"],
      "@hk/country-packs/cm": ["./libs/country-packs/cm/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
