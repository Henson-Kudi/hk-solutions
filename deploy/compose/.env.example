# Optional overrides for docker-compose.yml. Copy to .env (gitignored).
# These are local development values only. Never put a real credential here.

# Host ports. The containers always listen on 5432 and 6379 internally.
HK_PG_PORT=54320
HK_REDIS_PORT=63790

# Postgres superuser, used once to run deploy/sql/bootstrap.sql.
HK_PG_SUPERUSER=postgres
HK_PG_SUPERUSER_PASSWORD=postgres
HK_PG_DATABASE=hk
